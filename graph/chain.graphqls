type ChainInfo {
  is_main: Boolean!
  cloud_contract: String!
  subnet_contract: String!
  """展示用网络名称（如 Paseo / Polkadot）"""
  network_label: String!
  """Subscan Open API 根地址，如 https://assethub-paseo.api.subscan.io"""
  subscan_api_base: String!
}

extend type Query {
  chain_info: [ChainInfo!]!
  validators: [String!]!
}

extend type Mutation {
  start_epoch: Boolean!
}
